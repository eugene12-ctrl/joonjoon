#!/bin/sh
# 커밋 메시지 첫 줄이 "<종류>: <요약>" 형식인지 확인합니다.

first=$(head -n 1 "$1")

# git이 자동으로 만드는 merge/revert 메시지는 통과
if echo "$first" | grep -Eq '^(Merge|Revert) '; then
  exit 0
fi

if ! echo "$first" | grep -Eq '^(feat|fix|style|refactor|docs|chore|test)(\([^)]+\))?: .+'; then
  echo "[커밋 차단] 커밋 메시지 형식이 맞지 않습니다: $first"
  echo "  형식: <종류>: <요약>  (종류: feat, fix, style, refactor, docs, chore, test)"
  echo "  예: feat: 신규 기능 페이지 기본 레이아웃 추가"
  exit 1
fi

exit 0
